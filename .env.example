# MCP Tool Security Profile (safe | workspace | workspace_write | network | diagnostics | benchmark | admin | all)
# Default is 'safe' which exposes only non-intrusive tools (echo, ping).
MCP_PROFILE=safe

# Operational log level (debug | info | warn | error | off, default: info)
# Empty value is treated as unset/default (info) with no warning.
MCP_LOG_LEVEL=info

# HTTP Transport Port (Used when running with --transport=http, 1 to 65535)
PORT=3000

# Optional JSON array of allowlisted workspace root paths.
# Required when running with workspace, workspace_write, or all profile if --root is omitted.
# MCP_ROOTS_JSON=["/path/to/project"]

# Maximum workspace file write/edit size cap in bytes (1 to 5242880, default: 1048576)
# MCP_WORKSPACE_MAX_WRITE_BYTES=1048576

# Maximum workspace resource read size cap in bytes (1 to 5242880, default: 1048576)
# MCP_WORKSPACE_MAX_RESOURCE_BYTES=1048576

# Optional client-mediated approval for workspace_write/all text mutations.
# Default: false. Requires a form-elicitation-capable client; see README compatibility table.
# MCP_WORKSPACE_WRITE_CONFIRMATION=true

# Optional JSON array of allowed public hostname patterns for network profile (fetch_url).
# MCP_NETWORK_ALLOW_HOSTS_JSON=["example.com","*.githubusercontent.com"]

# Optional JSON array of denied hostname patterns for network profile.
# MCP_NETWORK_DENY_HOSTS_JSON=["ads.example.com"]

# Enforce HTTPS-only mode for fetch_url (true/1/false/0, default: false)
# MCP_NETWORK_HTTPS_ONLY=true

# Maximum response representation bytes for fetch_url (1 to 5242880, default: 5242880)
# MCP_NETWORK_MAX_RESPONSE_BYTES=5242880

# Maximum timeout in milliseconds for fetch_url (1000 to 30000, default: 30000)
# MCP_NETWORK_MAX_TIMEOUT_MS=30000

# Enable conditional in-memory response cache for fetch_url (true/1/false/0, default: false)
# MCP_NETWORK_CACHE_ENABLED=true

# Logical maximum cache payload size in bytes for network cache (1024 to 67108864, default: 16777216)
# MCP_NETWORK_CACHE_MAX_SIZE_BYTES=16777216

# Maximum number of entries in network conditional response cache (1 to 512, default: 128)
# MCP_NETWORK_CACHE_MAX_ENTRIES=128

# Maximum retention TTL in milliseconds for network cache (1000 to 3600000, default: 300000)
# MCP_NETWORK_CACHE_TTL_MS=300000

# Reusable Worker Thread Pool Capacity (1 to 16, default: up to 4 CPU cores)
MCP_WORKER_COUNT=4

# In-Memory LRU Compute Cache Maximum Entries (1 to 10000, default: 256)
MCP_CACHE_MAX_ENTRIES=256

# In-Memory LRU Compute Cache Time-to-Live in Milliseconds (1000 to 86400000, default: 300000)
MCP_CACHE_TTL_MS=300000
