# MCP Tool Security Profile (safe | workspace | diagnostics | benchmark | admin | all)
# Default is 'safe' which exposes only non-intrusive tools (echo, ping).
MCP_PROFILE=safe

# Optional JSON array of read-only workspace roots.
# Only required when running with workspace or all profile.
# MCP_ROOTS_JSON=["/path/to/project"]

# Optional client-mediated approval for workspace_write/all text mutations.
# Default: false. Requires a form-elicitation-capable client; see README compatibility table.
# MCP_WORKSPACE_WRITE_CONFIRMATION=true

# HTTP Transport Port (Used when running with --transport=http)
PORT=3000

# Reusable Worker Thread Pool Capacity (1 to 16)
MCP_WORKER_COUNT=4

# In-Memory LRU Cache Maximum Entries (1 to 10000)
MCP_CACHE_MAX_ENTRIES=256

# In-Memory LRU Cache Time-to-Live in Milliseconds (1000 to 86400000)
MCP_CACHE_TTL_MS=300000
