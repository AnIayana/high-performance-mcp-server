{
  "name": "high-performance-mcp-server",
  "version": "0.1.0",
  "description": "High-performance, modular MCP v2 server with safe-by-default profiles, Streamable HTTP, stdio, worker threads, metrics, and LRU caching",
  "type": "module",
  "bin": {
    "high-performance-mcp-server": "bin/cli.js"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "scripts": {
    "generate:tools": "tsx scripts/generate-tool-registry.ts",
    "generate:meta": "tsx scripts/generate-build-meta.ts",
    "generate": "npm run generate:tools && npm run generate:meta",
    "check:generated": "tsx scripts/check-generated.ts",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run generate",
    "build": "tsup",
    "prepack": "npm run generate && npm run typecheck && npm test && npm run build",
    "pack:check": "npm pack --dry-run",
    "smoke:package": "tsx scripts/package-smoke-test.ts",
    "security:package": "tsx scripts/package-security-check.ts",
    "security:repo": "tsx scripts/repository-security-check.ts",
    "test": "tsx --test tests/worker-pool.test.ts tests/cache.test.ts tests/tool-profile.test.ts tests/cli.test.ts tests/build-meta.test.ts tests/server-instructions.test.ts tests/prompts.test.ts tests/workspace-security.test.ts tests/workspace.test.ts tests/workspace-search.test.ts tests/modern-protocol.test.ts tests/release-metadata.test.ts tests/release-automation.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --transport=stdio",
    "start:http": "node dist/index.js --transport=http --port=3000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eminyilmz/high-performance-mcp-server.git"
  },
  "homepage": "https://github.com/eminyilmz/high-performance-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/eminyilmz/high-performance-mcp-server/issues"
  },
  "mcpName": "io.github.eminyilmz/high-performance-mcp-server",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "modelcontextprotocol",
    "mcp-server",
    "ai",
    "llm",
    "stdio",
    "streamable-http"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "lru-cache": "^11.5.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
